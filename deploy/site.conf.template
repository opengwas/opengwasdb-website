# The opengwas.io web server: one nginx server block, used both by the container
# (deploy/Dockerfile; the image fills in ${...} from its environment when it
# starts) and by the native run (deploy/web.py fills it in the same way).
#
#   ${WEB_ROOT}     the folder holding the built site, at ${WEB_ROOT}/site
#   ${LISTEN_PORT}  the port to listen on
#
# What the site needs from its server is listed in CONTRIBUTING.md
# ("Publishing") and decisions 8, 12, 13 and 14.

server {
    listen ${LISTEN_PORT};
    server_name _;
    root ${WEB_ROOT}/site;
    index index.html;
    charset utf-8;
    server_tokens off;
    # Redirects (/about -> /about/) keep the visitor's own host and port, which a
    # proxy or a container's port mapping would otherwise get wrong.
    absolute_redirect off;

    # Compress text. Never the catalogue: the Data page reads it in byte ranges,
    # and refuses a compressed file (decision 13). .sqlite is not a listed type.
    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json application/xml
               application/atom+xml image/svg+xml text/plain application/wasm;

    # Pages: revalidate every time, so a rebuild shows at once.
    location / {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Files whose address changes when their content does: the assets carry a
    # ?v=<hash>, and a catalogue version's files never change (decision 7).
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
    location ~ ^/data/catalog/[0-9a-f]+/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # A missing page under /datasets/ gets the legacy-ID page; any other missing
    # page gets the site's 404 page (decision 8). Both keep the 404 status.
    location /datasets/ {
        error_page 404 /datasets/404.html;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
    error_page 404 /404.html;
}
